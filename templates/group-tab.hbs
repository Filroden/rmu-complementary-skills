<div class="rmucsc-tab-content rmucsc-scrollable {{#if (eq activeTab 'group')}}active{{/if}}" data-tab="group">
    <form class="rmucsc-calc-wrapper" autocomplete="off">
        <div class="rmucsc-calc-pane">

        <fieldset class="rmucsc-fieldset">
            <legend>{{localize "RMU_CS.Group.TaskSkill"}}</legend>
            <div class="form-group">
                <label>{{localize "RMU_CS.Common.Skill"}}</label>
                <div class="form-fields">
                    <select class="rmucsc-task-skill-select" name="taskSkillName">
                        <option value="">{{localize "RMU_CS.Group.SelectTask"}}</option>
                        {{#each allSkillOptions}}
                        <optgroup label="{{label}}">
                            {{#each skills}}
                            <option value="{{uuid}}" {{rmucsSelected (eq name ../../taskSkillName)}}>{{name}}</option>
                            {{/each}}
                        </optgroup>
                        {{/each}}
                    </select>
                </div>
            </div>
        </fieldset>

        <fieldset class="rmucsc-fieldset">
            <legend>{{localize "RMU_CS.Boost.Participants"}}</legend>
            <div class="rmucsc-participant-list" id="group-task-participants">
                <div class="rmucsc-participant-row rmucsc-participant-header">
                    <span>{{localize "RMU_CS.Common.Enabled"}}</span>
                    <span>{{localize "RMU_CS.Group.Leader"}}</span>
                    <span>{{localize "RMU_CS.Common.Participant"}}</span>
                    <span>{{localize "RMU_CS.Group.LeaderRanks"}}</span>
                    <span>{{localize "RMU_CS.Common.SkillBonus"}}</span>
                </div>
                {{#each participants}}
                <div class="rmucsc-participant-row">
                    <input type="checkbox" class="rmucsc-checkbox rmucsc-participant-enable" data-id="{{id}}" {{checked enabled}} />
                    <input type="radio" class="rmucsc-leader-select" name="leader" value="{{id}}" {{checked (eq id ../leaderId)}} {{disabled (not enabled)}} />
                    <label>{{name}}</label>
                    <span class="rmucsc-participant-ranks">{{leadershipRanks}}</span>
                    <span class="rmucsc-participant-bonus">{{signed bonusForSelectedSkill}}</span>
                </div>
                {{/each}}
            </div>
            <div class="rmucsc-add-wrapper">
                <button type="button" class="rmucsc-btn rmucsc-add-participant" data-action="toggleSidePanel">
                    <i class="rmucsc-icon add"></i> {{localize "RMU_CS.Common.AddParticipant"}}
                </button>
            </div>
        </fieldset>

        <fieldset class="rmucsc-fieldset">
            <legend>{{localize "RMU_CS.Common.Calculation"}}</legend>
            <div class="rmucsc-output-box rmucsc-scrollable stable">
                <div class="rmucsc-output-row">
                    <span>{{localize "RMU_CS.Group.AvgBonus"}}</span>
                    <span class="rmucsc-output-value">{{signed calculation.averageBonus}}</span>
                </div>
                <div class="rmucsc-output-row">
                    <span>{{localize "RMU_CS.Group.LeadershipRanks" name=calculation.leaderName}}</span>
                    <span class="rmucsc-output-value">{{signed calculation.leadershipBonus}}</span>
                </div>
                <div class="rmucsc-output-row rmucsc-output-total">
                    <span>{{localize "RMU_CS.Common.TotalBonus"}}:</span>
                    <span class="rmucsc-output-value">{{signed calculation.total}}</span>
                </div>
            </div>

            {{#if calculation.participants}}
            <div class="rmucsc-output-breakdown">
                <span class="rmucsc-notes">{{localize "RMU_CS.Group.PartBonuses"}}</span>
                <ul>
                    {{#each calculation.participants}}
                    <li>
                    <strong>{{signed bonus}}</strong> ({{name}})
                    </li>
                    {{/each}}
                </ul>
            </div>
            {{/if}}

        </fieldset>
        </div>
    </form>

    <footer class="rmucsc-calc-footer">
        <button type="button" class="rmucsc-btn rmucsc-send-chat">
            <i class="rmucsc-icon chat"></i> {{localize "RMU_CS.Common.SendChat"}}
        </button>
    </footer>
</div>