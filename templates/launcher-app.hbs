<div class="rmu-calc-pane">
  <p class="rmu-notes">
    {{localize "RMU_CS.Launcher.Notes"}}
  </p>

  <div class="rmu-launcher-buttons">
    <button type="button" data-action="open-rule1">
      <img src="modules/rmu-complementary-skills/assets/boost-skill.svg" class="rmu-launcher-icon" alt="{{localize 'RMU_CS.Launcher.BoostTitle'}}" />
      <div class="rmu-button-text">
        <span class="rmu-button-title">{{localize "RMU_CS.Launcher.BoostTitle"}}</span>
        <span class="rmu-button-note">{{localize "RMU_CS.Launcher.BoostNote"}}</span>
      </div>
    </button>

    <button type="button" data-action="open-rule2">
      <img src="modules/rmu-complementary-skills/assets/group-task.svg" class="rmu-launcher-icon" alt="{{localize 'RMU_CS.Launcher.GroupTitle'}}" />
      <div class="rmu-button-text">
        <span class="rmu-button-title">{{localize "RMU_CS.Launcher.GroupTitle"}}</span>
        <span class="rmu-button-note">{{localize "RMU_CS.Launcher.GroupNote"}}</span>
      </div>
    </button>
  </div>
</div>